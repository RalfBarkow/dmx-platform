# .envrc — dmx-zettelkasten (+ dmx-dita) dev env

# Load the Nix flake devShell defined in flake.nix
use flake

# ----- DMX platform & plugins -------------------------------------------------
# DMX platform checkout (override if not at ../dmx-platform)
export DMX_DIR="${DMX_DIR:-$(cd "$(git rev-parse --show-toplevel)/.."; pwd)/dmx-platform}"

# Which DMX plugins this repo cooperates with (space-separated)
# Include dmx-dita here to relate this project to it.
export DMX_PLUGINS="${DMX_PLUGINS:-dmx-zettelkasten dmx-dita dmx-fedwiki}"

# Preferred JDK for plugin-build (used by your flake’s scripts): 8 or 11
export DMX_JAVA="${DMX_JAVA:-8}"

# ----- Tooling knobs ----------------------------------------------------------
# Webpack/Node >= 17 OpenSSL 3 workaround (frontend dev)
export NODE_OPTIONS="${NODE_OPTIONS:---openssl-legacy-provider}"

# Maven heap defaults (tweak as needed)
export MAVEN_OPTS="${MAVEN_OPTS:--Xms512m -Xmx2g}"

# Optional: add repo-local bin to PATH (if you keep helper scripts there)
# PATH_add ./bin

# ----- Friendly status on activation -----------------------------------------
if [[ -t 1 ]]; then
  echo
  echo "dmx devshell ready."
  echo "  DMX_DIR   = $DMX_DIR"
  echo "  DMX_JAVA  = $DMX_JAVA   (devShell default JDK set by flake)"
  echo "  Plugins   = $DMX_PLUGINS"
  for p in $DMX_PLUGINS; do
    if [ -d "modules-external/$p" ]; then
      echo "    ✓ modules-external/$p"
    else
      echo "    ✗ modules-external/$p (missing)"
    fi
  done
  echo "Helper commands from flake:"
  echo "  dmx-clone · dmx-build · dmx-plugin-dev-link · dmx-run-backend"
  echo "  dmx-run-backend-port · dmx-run-frontend · plugin-build"
  echo "  plugin-watch · dmx-free-8080 · dmx-reset-db"
  echo "  dmx-run-backend-j11 · dmx-build-j11"
  echo
fi
